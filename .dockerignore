# Exclude everything that should not be copied into the Docker build context.
.git
.gitignore
.github
node_modules
vendor
storage/*.key
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
public/build
public/hot
.env
.env.*
!.env.example
.phpunit.result.cache
.phpunit.cache
*.log
Dockerfile
docker-compose.yml
docker-compose.override.yml
